# jump.sh Configuration

# ---- HTTPS ----
# Set to true to enable HTTPS. Certs are downloaded by `jumpsh certs`
# or automatically during `jumpsh install`. Falls back to HTTP if missing.
JUMPSH_HTTPS=true

# ---- Port ----
# For clean no-port URLs, set port to 443:
JUMPSH_PORT=4443
# On Linux, Node needs low-port capability. Run once:
#   scripts/enable-low-port-bind-linux.sh
# On macOS, port 443 works without extra setup.
#
# Fallback: keep 5050 if you don't want privileged port binding.
# JUMPSH_PORT=5050

# ---- Domain ----
# Projects will be accessible at {project}.{domain}
JUMPSH_DOMAIN=jump.sh

# ---- Cert origin ----
# Server to download certs from (default: https://jump.sh)
# JUMPSH_ORIGIN=https://jump.sh

# ---- Cert path ----
# Local directory for downloaded certificates (default: ~/.jump.sh/certs)
# Tilde (~) is expanded to $HOME at runtime.
JUMPSH_CERT_PATH=~/.jump.sh/certs

# ---- Remote control plane ----
# API origin for remote commands (login, register, sync)
# JUMPSH_API_ORIGIN=https://jump.sh

# Remote domain for this machine (default: dmg.jump.sh)
# JUMPSH_REMOTE_DOMAIN=dmg.jump.sh

# How often the daemon syncs remote routes, in seconds (default: 30)
# JUMPSH_REMOTE_SYNC_SECONDS=30

# Dashboard host (default: dash.jump.sh)
# JUMPSH_DASHBOARD_HOST=dash.jump.sh
