# Localhaus Configuration

# Port for the dashboard
LOCALHAUS_PORT=5050

# Domain for subdomain routing
# Projects will be accessible at {project}.{domain}
LOCALHAUS_DOMAIN=localhost

# Enable HTTPS (requires mkcert setup)
LOCALHAUS_HTTPS=false

# Path to SSL certificates (if HTTPS enabled)
LOCALHAUS_CERT_PATH=~/.localhaus/certs
