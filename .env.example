# Localhaus Configuration

# ---- HTTPS (recommended) ----
# Run scripts/setup-macos.sh or scripts/setup-linux.sh first to install certs.
# If true but cert files are missing, falls back to HTTP with a warning.
LOCALHAUS_HTTPS=true

# ---- Port ----
# For clean no-port URLs (https://localhaus.localhost), set port to 443:
LOCALHAUS_PORT=443
# On Linux, Node needs low-port capability. Run once:
#   scripts/enable-low-port-bind-linux.sh
# On macOS, port 443 works without extra setup.
#
# Fallback: keep 5050 if you don't want privileged port binding.
# URLs will include the port: https://localhaus.localhost:5050
# LOCALHAUS_PORT=5050

# ---- Domain ----
# Projects will be accessible at {project}.{domain}
LOCALHAUS_DOMAIN=localhost

# ---- Cert path ----
# Path to mkcert certificates (default: ~/.localhaus/certs)
# Tilde (~) is expanded to $HOME at runtime
LOCALHAUS_CERT_PATH=~/.localhaus/certs
