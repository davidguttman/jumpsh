<%# locals: project, worktrees, logs, detection, config %>
<div class="project-header">
  <h2><%= project.name %></h2>
  <% const health = project.health || 'unknown'; %>
  <span class="status-indicator hidden" id="status-indicator-<%= project.id %>"></span>
  <span class="startup-progress hidden" id="startup-progress-<%= project.id %>"></span>
</div>

<div class="project-info">
  <p><code><%= project.path %></code></p>
  <p>
    <% if (health === 'healthy') { %>
      <a href="<%= config.projectUrl(project.subdomain) %>" target="_blank" id="subdomain-link-<%= project.id %>">
        <%= config.projectUrl(project.subdomain).replace(/^https?:\/\//, '') %>
      </a>
    <% } else { %>
      <span id="subdomain-link-<%= project.id %>"><%= config.projectUrl(project.subdomain).replace(/^https?:\/\//, '') %></span>
    <% } %>
  </p>
</div>

<div class="settings-section">
  <button class="nav-action settings-toggle" id="settings-toggle-<%= project.id %>" onclick="toggleSettings(<%= project.id %>)">settings</button>
  <div class="settings-panel hidden" id="settings-panel-<%= project.id %>">
    <h3>Command Overrides</h3>
    <p class="settings-hint">Leave empty to use auto-detected values.</p>
    <div class="settings-form">
      <div class="form-group">
        <label class="label" for="override_build_command-<%= project.id %>">Build Command</label>
        <input class="input" type="text" id="override_build_command-<%= project.id %>" autocapitalize="off"
          value="<%= project.override_build_command || '' %>"
          placeholder="<%= detection.installCommand || 'auto-detect' %>">
      </div>
      <div class="form-group">
        <label class="label" for="override_start_command-<%= project.id %>">Start Command</label>
        <input class="input" type="text" id="override_start_command-<%= project.id %>" autocapitalize="off"
          value="<%= project.override_start_command || '' %>"
          placeholder="<%= detection.devCommand || 'auto-detect' %>">
      </div>
      <div class="form-group">
        <label class="label" for="override_port-<%= project.id %>">Port</label>
        <input class="input" type="number" id="override_port-<%= project.id %>"
          value="<%= project.override_port || '' %>"
          placeholder="<%= detection.port || 'auto-detect' %>">
      </div>
      <div class="form-group">
        <label class="label" for="override_docker_image-<%= project.id %>">Docker Image</label>
        <input class="input" type="text" id="override_docker_image-<%= project.id %>" autocapitalize="off"
          value="<%= project.override_docker_image || '' %>"
          placeholder="<%= detection.dockerImage || 'auto-detect' %>">
      </div>
      <div class="form-group">
        <label class="label">Environment Overrides</label>
        <div id="env-vars-container-<%= project.id %>"></div>
        <button type="button" class="btn btn-sm" id="add-env-var-<%= project.id %>">+ Add Variable</button>
      </div>
      <div class="settings-actions">
        <button class="btn" id="save-settings-btn-<%= project.id %>" onclick="saveSettings(<%= project.id %>)">Save</button>
        <span class="settings-feedback" id="settings-feedback-<%= project.id %>"></span>
      </div>
    </div>
  </div>
</div>

<div class="project-actions" style="display: flex; justify-content: space-between; align-items: center;">
  <button class="btn btn-danger-outline" onclick="deleteProject(<%= project.id %>)">Delete</button>
  <div style="display: flex; gap: 0.5rem; align-items: center;" data-project-detail-actions="<%= project.id %>">
    <span class="project-detail-status hidden" id="project-detail-status-<%= project.id %>" role="status" aria-live="polite"></span>
    <% if (project.status === 'running') { %>
      <button class="btn" onclick="restartProject(<%= project.id %>)">Restart</button>
    <% } %>
    <%- include('_action_btn', { id: project.id, status: project.status }) %>
  </div>
</div>

<% if (worktrees.length === 0) { %>
  <p class="wt-hint">Place worktrees in <code>.worktrees/</code> to auto-discover</p>
<% } %>
<% if (worktrees.length > 0) { %>
  <div class="worktrees-section">
    <div class="worktrees-header">
      <h3>Worktrees (<%= worktrees.length %>)</h3>
      <% if (worktrees.length > 1) { %>
        <select class="input wt-sort-select" id="wt-sort-<%= project.id %>" aria-label="Sort worktrees">
          <option value="recency">sort: recent</option>
          <option value="name">sort: name</option>
        </select>
      <% } %>
    </div>
    <table class="worktrees-table">
      <tbody id="worktrees-tbody-<%= project.id %>">
        <% for (const wt of worktrees) { %>
          <tr data-wt-name="<%= wt.branch_name %>" data-wt-recency="<%= wt.recency_ms || 0 %>">
            <td>
              <a href="<%= config.projectUrl(wt.subdomain) %>" target="_blank">
                <code><%= wt.branch_name %></code>
              </a>
              <% // 8640000000000000 = max valid Date value; beyond it toISOString() throws
                 const recencyIso = Number.isFinite(wt.recency_ms) && wt.recency_ms > 0 && wt.recency_ms <= 8640000000000000
                   ? new Date(wt.recency_ms).toISOString()
                   : null; %>
              <% if (wt.recency_label && recencyIso) { %>
                <span class="wt-recency" title="<%= recencyIso %>"><%= wt.recency_label %></span>
              <% } %>
            </td>
            <td style="text-align: right;">
              <%- include('_action_btn', { id: wt.id, status: wt.status, btnClass: 'btn-sm' }) %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="build-logs-section hidden" id="build-logs-section-<%= project.id %>">
  <h3>
    <button class="build-logs-toggle" id="build-logs-toggle-<%= project.id %>" onclick="toggleBuildLogs(<%= project.id %>)">Build Logs (click to expand)</button>
  </h3>
  <pre class="build-logs-output hidden" id="build-logs-output-<%= project.id %>"></pre>
</div>

<div class="logs-section">
  <h3>Logs</h3>
  <select class="logs-tab-select input" id="logs-tabs-<%= project.id %>">
    <option value="<%= project.id %>" data-log-id="<%= project.id %>" data-log-label="<%= project.name %>"><%= project.name %></option>
    <% for (const wt of worktrees) { %>
      <option value="<%= wt.id %>" data-log-id="<%= wt.id %>" data-log-label="<%= wt.branch_name %>" data-wt-name="<%= wt.branch_name %>" data-wt-recency="<%= wt.recency_ms || 0 %>"><%= wt.branch_name %></option>
    <% } %>
  </select>
  <pre class="logs-output" id="logs-<%= project.id %>"><%= logs %></pre>
  <div class="logs-status hidden" id="logs-status-<%= project.id %>"></div>
</div>

<script>
(function() {
  var pid = <%= project.id %>;

  // Per-project state registry (no global conflicts)
  var ns = window._pd = window._pd || {};
  if (ns[pid]) return; // already initialized
  ns[pid] = { eventSource: null, activeLogId: null, buildLines: [], wtRecencyTimer: null };
  var state = ns[pid];

  // --- Build logs ---
  function showBuildLog(id, content) {
    var section = document.getElementById('build-logs-section-' + id);
    var output = document.getElementById('build-logs-output-' + id);
    if (!section || !output) return;
    output.textContent = content;
    section.classList.remove('hidden');
    output.classList.remove('hidden');
    output.scrollTop = output.scrollHeight;
  }

  window.toggleBuildLogs = window.toggleBuildLogs || function(id) {
    var output = document.getElementById('build-logs-output-' + id);
    var toggle = document.getElementById('build-logs-toggle-' + id);
    if (output.classList.contains('hidden')) {
      output.classList.remove('hidden');
      toggle.textContent = 'Build Logs (click to collapse)';
      output.scrollTop = output.scrollHeight;
    } else {
      output.classList.add('hidden');
      toggle.textContent = 'Build Logs (click to expand)';
    }
  };

  // --- Startup subscription ---
  function subscribeStartup(id) {
    var s = ns[id] || state;
    var badge = document.getElementById('status-indicator-' + id);
    var progress = document.getElementById('startup-progress-' + id);
    s.buildLines = [];
    if (badge) { badge.className = 'status-indicator starting'; badge.textContent = 'STARTING...'; }
    if (progress) progress.classList.remove('hidden');

    var es = new EventSource('/projects/' + id + '/startup');
    es.onmessage = function(e) {
      var data = JSON.parse(e.data);
      if (data.buildLine) s.buildLines.push(data.buildLine);
      if (data.step && data.totalSteps && progress) {
        progress.textContent = 'Step ' + data.step + '/' + data.totalSteps + ': ' + (data.label || '');
      }
      if (data.done && !data.error) { es.close(); location.reload(); }
      if (data.error) {
        es.close();
        if (progress) progress.textContent = data.error;
        var logContent = data.buildLog || s.buildLines.join('\n');
        if (logContent) showBuildLog(id, logContent);
      }
    };
    es.onerror = function() {
      es.close();
      if (s.buildLines.length > 0) showBuildLog(id, s.buildLines.join('\n'));
    };
  }

  function showDetailStatus(id, message, isError) {
    var el = document.getElementById('project-detail-status-' + id);
    if (!el) return;
    el.textContent = message || '';
    el.className = 'project-detail-status' + (isError ? ' error' : '');
    if (!message) el.classList.add('hidden');
  }

  function detailErrorMessage(err) {
    return (err && err.message) ? err.message : String(err || 'Unknown error');
  }

  // --- Project actions (define once, shared across all detail instances) ---
  window.startProject = window.startProject || async function(id) {
    showDetailStatus(id, 'Starting...', false);
    subscribeStartup(id);
    try {
      var res = await fetch('/projects/' + id + '/start', { method: 'POST' });
      if (!res.ok) {
        var data = {};
        try { data = await res.json(); } catch (_) {}
        if (data.buildLog) showBuildLog(id, data.buildLog);
        showDetailStatus(id, 'Start failed: ' + (data.error || ('request failed (' + res.status + ')')), true);
      }
    } catch (err) {
      showDetailStatus(id, 'Start failed: ' + detailErrorMessage(err), true);
    }
  };

  window.stopProject = window.stopProject || async function(id, opts) {
    opts = opts || {};
    showDetailStatus(id, 'Stopping...', false);
    try {
      var res = await fetch('/projects/' + id + '/stop', { method: 'POST' });
      if (res.ok) {
        showDetailStatus(id, 'Stopped', false);
        if (opts.reload !== false) location.reload();
      } else {
        showDetailStatus(id, 'Stop failed: request failed (' + res.status + ')', true);
      }
      return res;
    } catch (err) {
      showDetailStatus(id, 'Stop failed: ' + detailErrorMessage(err), true);
      return { ok: false, error: err };
    }
  };

  window.restartProject = window.restartProject || async function(id) {
    showDetailStatus(id, 'Restarting...', false);
    var res = await window.stopProject(id, { reload: false });
    if (res.ok) setTimeout(function() { window.startProject(id); }, 1000);
    else showDetailStatus(id, 'Restart failed while stopping', true);
  };

  window.deleteProject = window.deleteProject || async function(id) {
    if (!confirm('Are you sure you want to delete this project?')) return;
    var res = await fetch('/projects/' + id, { method: 'DELETE' });
    if (res.ok) location.href = '/';
    else alert('Error deleting project');
  };

  // --- Settings ---
  window.toggleSettings = window.toggleSettings || function(id) {
    var panel = document.getElementById('settings-panel-' + id);
    var btn = document.getElementById('settings-toggle-' + id);
    if (panel.classList.contains('hidden')) { panel.classList.remove('hidden'); btn.textContent = 'hide settings'; }
    else { panel.classList.add('hidden'); btn.textContent = 'settings'; }
  };

  window.saveSettings = window.saveSettings || async function(id) {
    var feedback = document.getElementById('settings-feedback-' + id);
    var btn = document.getElementById('save-settings-btn-' + id);
    btn.disabled = true;
    feedback.textContent = '';
    feedback.className = 'settings-feedback';

    var body = {};
    var fields = ['override_build_command', 'override_start_command', 'override_docker_image'];
    for (var i = 0; i < fields.length; i++) {
      var val = document.getElementById(fields[i] + '-' + id).value.trim();
      body[fields[i]] = val || null;
    }
    var portVal = document.getElementById('override_port-' + id).value.trim();
    body.override_port = portVal ? parseInt(portVal, 10) : null;
    var envVars = window['_envVars_' + id] || [];
    var filtered = envVars.filter(function(v) { return v.key.trim() !== ''; });
    body.override_env = filtered.length ? JSON.stringify(filtered) : null;

    try {
      var res = await fetch('/api/projects/' + id, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      if (res.ok) { feedback.textContent = 'Saved'; feedback.className = 'settings-feedback success'; }
      else {
        var data = await res.json();
        feedback.textContent = data.error || 'Error';
        feedback.className = 'settings-feedback error';
      }
    } catch (e) {
      feedback.textContent = e.message;
      feedback.className = 'settings-feedback error';
    }
    btn.disabled = false;
    setTimeout(function() { feedback.textContent = ''; }, 3000);
  };

  // --- Env vars ---
  (function initEnvVars() {
    var rawEnv = <%- JSON.stringify(project.override_env || '') %>;
    var envVars = [];
    try { if (rawEnv) envVars = JSON.parse(rawEnv); } catch(e) {}

    function escapeAttr(s) {
      return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    }

    function renderEnvVars() {
      var container = document.getElementById('env-vars-container-' + pid);
      container.innerHTML = '';
      for (var i = 0; i < envVars.length; i++) {
        var row = document.createElement('div');
        row.className = 'env-var-row';
        row.style.cssText = 'display: flex; gap: 0.5rem; margin-bottom: 0.5rem; align-items: center;';
        row.innerHTML = '<input class="input" type="text" placeholder="KEY" value="' + escapeAttr(envVars[i].key) + '" data-idx="' + i + '" data-field="key" style="flex:1">' +
          '<input class="input" type="text" placeholder="value" value="' + escapeAttr(envVars[i].value) + '" data-idx="' + i + '" data-field="value" style="flex:1">' +
          '<button type="button" class="btn btn-sm" data-idx="' + i + '" style="padding:0.25rem 0.5rem">&times;</button>';
        row.querySelectorAll('input').forEach(function(inp) {
          inp.addEventListener('input', function() {
            envVars[parseInt(this.dataset.idx)][this.dataset.field] = this.value;
          });
        });
        row.querySelector('button').addEventListener('click', function() {
          envVars.splice(parseInt(this.dataset.idx), 1);
          renderEnvVars();
        });
        container.appendChild(row);
      }
    }

    document.getElementById('add-env-var-' + pid).addEventListener('click', function() {
      envVars.push({ key: '', value: '' });
      renderEnvVars();
    });

    renderEnvVars();
    window['_envVars_' + pid] = envVars;
  })();

  // --- Log streaming ---
  function showLogStatus(msg, isError) {
    var statusEl = document.getElementById('logs-status-' + pid);
    if (!statusEl) return;
    if (msg) {
      statusEl.textContent = msg;
      statusEl.className = 'logs-status' + (isError ? ' error' : '');
      statusEl.classList.remove('hidden');
    } else {
      statusEl.classList.add('hidden');
    }
  }

  function switchLogTab(id) {
    var logsEl = document.getElementById('logs-' + pid);
    var selectEl = document.getElementById('logs-tabs-' + pid);

    if (state.eventSource) { state.eventSource.close(); state.eventSource = null; }

    selectEl.value = String(id);

    state.activeLogId = id;
    logsEl.textContent = 'Loading logs...';
    showLogStatus(null);

    fetch('/projects/' + id + '/logs?lines=200')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        logsEl.textContent = '';
        if (data.lines && data.lines.length > 0) {
          data.lines.forEach(function(l) {
            var span = document.createElement('span');
            span.textContent = l + '\n';
            logsEl.appendChild(span);
          });
          logsEl.scrollTop = logsEl.scrollHeight;
        } else {
          logsEl.textContent = 'No logs yet';
        }
        startLogStream(id);
      })
      .catch(function(err) {
        logsEl.textContent = 'Error loading logs: ' + err.message;
        startLogStream(id);
      });
  }

  function startLogStream(id) {
    if (state.eventSource) { state.eventSource.close(); state.eventSource = null; }
    var logsEl = document.getElementById('logs-' + pid);
    showLogStatus(null);

    var es = new EventSource('/projects/' + id + '/logs/stream');
    state.eventSource = es;

    es.onmessage = function(e) {
      if (state.activeLogId !== id) return;
      try {
        var data = JSON.parse(e.data);
        if (data.line) {
          showLogStatus(null);
          if (logsEl.textContent === 'No logs yet') logsEl.textContent = '';
          var span = document.createElement('span');
          span.textContent = data.line + '\n';
          logsEl.appendChild(span);
          while (logsEl.childNodes.length > 1000) logsEl.removeChild(logsEl.childNodes[0]);
          logsEl.scrollTop = logsEl.scrollHeight;
        }
        if (data.closed) { es.close(); state.eventSource = null; }
      } catch (_) {}
    };
    es.onerror = function() {
      es.close();
      state.eventSource = null;
      showLogStatus('Connection lost \u2014 reload to reconnect', true);
    };
  }

  // --- Worktree recency labels ---
  // Expanded details suppress the periodic page reload, so server-rendered
  // labels go stale; recompute them from data-wt-recency on an interval.
  // Keep the formatting rules in sync with lib/relative-time.js.
  var WT_RECENCY_MAX_MS = 8640000000000000; // max valid Date value
  var WT_RECENCY_UNITS = (function() {
    var minute = 60 * 1000;
    var hour = 60 * minute;
    var day = 24 * hour;
    return [
      { ms: 365 * day, name: 'year' },
      { ms: 30 * day, name: 'month' },
      { ms: 7 * day, name: 'week' },
      { ms: day, name: 'day' },
      { ms: hour, name: 'hour' },
      { ms: minute, name: 'minute' },
    ];
  })();

  function formatWtRecencyLabel(recencyMs, nowMs) {
    if (!isFinite(recencyMs) || recencyMs <= 0 || recencyMs > WT_RECENCY_MAX_MS) return '';
    var elapsedMs = nowMs - recencyMs;
    for (var i = 0; i < WT_RECENCY_UNITS.length; i++) {
      var unit = WT_RECENCY_UNITS[i];
      if (elapsedMs >= unit.ms) {
        var count = Math.floor(elapsedMs / unit.ms);
        return count + ' ' + unit.name + (count === 1 ? '' : 's') + ' ago';
      }
    }
    return 'just now';
  }

  function refreshWtRecencyLabels(nowMs) {
    var tbody = document.getElementById('worktrees-tbody-' + pid);
    if (!tbody) return;
    var rows = tbody.querySelectorAll('tr[data-wt-recency]');
    for (var i = 0; i < rows.length; i++) {
      var labelEl = rows[i].querySelector('.wt-recency');
      if (!labelEl) continue;
      var text = formatWtRecencyLabel(Number(rows[i].dataset.wtRecency), nowMs);
      // Empty means the timestamp is unusable; keep the server-rendered text
      if (text) labelEl.textContent = text;
    }
  }

  (function initWtRecencyLabels() {
    if (!document.getElementById('worktrees-tbody-' + pid)) return;
    refreshWtRecencyLabels(Date.now());
    state.wtRecencyTimer = setInterval(function() {
      refreshWtRecencyLabels(Date.now());
    }, 30000);
  })();

  // --- Worktree sort ---
  (function initWorktreeSort() {
    var sortEl = document.getElementById('wt-sort-' + pid);
    if (!sortEl) return;

    function reorderByWorktreeSort(parent, nodes, mode) {
      var sorted = Array.prototype.slice.call(nodes);
      sorted.sort(function(a, b) {
        if (mode === 'name') return (a.dataset.wtName || '').localeCompare(b.dataset.wtName || '');
        return Number(b.dataset.wtRecency || 0) - Number(a.dataset.wtRecency || 0);
      });
      sorted.forEach(function(node) { parent.appendChild(node); });
    }

    function applyWorktreeSort(mode) {
      var tbody = document.getElementById('worktrees-tbody-' + pid);
      if (tbody) reorderByWorktreeSort(tbody, tbody.querySelectorAll('tr[data-wt-name]'), mode);
      var logSelect = document.getElementById('logs-tabs-' + pid);
      if (logSelect) reorderByWorktreeSort(logSelect, logSelect.querySelectorAll('option[data-wt-name]'), mode);
    }

    // Storage can throw (e.g. SecurityError when blocked); sorting must
    // survive without persistence so the rest of the script still runs
    function readWtSort() {
      try { return localStorage.getItem('jumpsh-wt-sort'); } catch (_) { return null; }
    }

    function saveWtSort(mode) {
      try { localStorage.setItem('jumpsh-wt-sort', mode); } catch (_) {}
    }

    // Server renders recency order; restore a persisted name preference
    var savedWtSort = readWtSort();
    var wtSortMode = savedWtSort === 'name' ? 'name' : 'recency';
    sortEl.value = wtSortMode;
    if (wtSortMode !== 'recency') applyWorktreeSort(wtSortMode);

    sortEl.addEventListener('change', function() {
      var mode = this.value === 'name' ? 'name' : 'recency';
      saveWtSort(mode);
      applyWorktreeSort(mode);
    });
  })();

  // --- Init ---
  // Bind log source select
  document.getElementById('logs-tabs-' + pid).addEventListener('change', function() {
    switchLogTab(parseInt(this.value));
  });

  // Auto-stream main tab
  state.activeLogId = pid;
  startLogStream(pid);

  // Subscribe to startup if currently starting
  <% if ((project.health || 'unknown') === 'starting') { %>
  subscribeStartup(pid);
  <% } %>

  // Load build log if unhealthy
  <% if ((project.health || 'unknown') === 'unhealthy') { %>
  fetch('/api/projects/' + pid + '/build-log')
    .then(function(res) { return res.json(); })
    .then(function(data) { if (data.buildLog) showBuildLog(pid, data.buildLog); })
    .catch(function() {});
  <% } %>

  // Cleanup on unload
  window.addEventListener('beforeunload', function() {
    if (state.eventSource) { state.eventSource.close(); state.eventSource = null; }
  });
})();
</script>
