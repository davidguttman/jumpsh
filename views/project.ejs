<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.name %> - jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦘</text></svg>">
  <style>
    .build-logs-section { margin-top: 1rem; }
    .build-logs-toggle {
      background: none; border: none; color: #ff6b6b; cursor: pointer;
      font-size: 1rem; font-weight: bold; padding: 0; text-decoration: underline;
    }
    .build-logs-toggle:hover { color: #ff8787; }
    .logs-tabs { display: flex; gap: 0; margin-bottom: 0; }
    .logs-tab {
      background: none; border: 1px solid #333; border-bottom: none;
      color: #888; cursor: pointer; padding: 0.4rem 0.8rem;
      font-size: 0.85rem; font-family: inherit; border-radius: 4px 4px 0 0;
    }
    .logs-tab:hover { color: #ccc; }
    .logs-tab.active { color: #fff; background: #1a1a1a; border-color: #555; }
    .logs-output { margin-top: 0; border-top-left-radius: 0; }
    .build-logs-output {
      background: #0d1117; color: #e6edf3; font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
      font-size: 0.8rem; line-height: 1.5; padding: 1rem; border-radius: 6px;
      max-height: 500px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word;
      border: 1px solid #ff6b6b33; margin-top: 0.5rem;
    }
  </style>
</head>
<body>
  <%- include('partials/_header') %>

  <main>
    <div class="panel project-detail">
      <div class="project-header">
        <h2><%= project.name %></h2>
        <% const health = project.health || 'unknown'; %>
        <span class="status-indicator hidden" id="status-indicator"></span>
        <span class="startup-progress hidden" id="startup-progress"></span>
      </div>

      <div class="project-info">
        <p><code><%= project.path %></code></p>
        <p>
          <% if (health === 'healthy') { %>
            <a href="<%= config.formatUrl(project.subdomain + '.' + config.domain) %>" target="_blank" id="subdomain-link">
              <%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %>
            </a>
          <% } else { %>
            <span id="subdomain-link"><%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %></span>
          <% } %>
        </p>
      </div>

      <div class="settings-section">
        <button class="nav-action settings-toggle" id="settings-toggle" onclick="toggleSettings()">settings</button>
        <div class="settings-panel hidden" id="settings-panel">
          <h3>Command Overrides</h3>
          <p class="settings-hint">Leave empty to use auto-detected values.</p>
          <div class="settings-form">
            <div class="form-group">
              <label class="label" for="override_build_command">Build Command</label>
              <input class="input" type="text" id="override_build_command" autocapitalize="off"
                value="<%= project.override_build_command || '' %>"
                placeholder="<%= detection.installCommand || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_start_command">Start Command</label>
              <input class="input" type="text" id="override_start_command" autocapitalize="off"
                value="<%= project.override_start_command || '' %>"
                placeholder="<%= detection.devCommand || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_port">Port</label>
              <input class="input" type="number" id="override_port"
                value="<%= project.override_port || '' %>"
                placeholder="<%= detection.port || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_docker_image">Docker Image</label>
              <input class="input" type="text" id="override_docker_image" autocapitalize="off"
                value="<%= project.override_docker_image || '' %>"
                placeholder="<%= detection.dockerImage || 'auto-detect' %>">
            </div>
            <div class="settings-actions">
              <button class="btn" id="save-settings-btn" onclick="saveSettings()">Save</button>
              <span class="settings-feedback" id="settings-feedback"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="project-actions" style="display: flex; justify-content: space-between; align-items: center;">
        <button class="btn btn-danger-outline" onclick="deleteProject(<%= project.id %>)">Delete</button>
        <div style="display: flex; gap: 0.5rem;">
          <% if (project.status === 'running') { %>
            <button class="btn" onclick="restartProject(<%= project.id %>)">Restart</button>
            <button class="btn btn-danger" onclick="stopProject(<%= project.id %>)">Stop</button>
          <% } else { %>
            <button class="btn btn-success" onclick="startProject(<%= project.id %>)">Start</button>
          <% } %>
        </div>
      </div>

      <% if (worktrees.length > 0) { %>
        <div class="worktrees-section">
          <h3>Worktrees (<%= worktrees.length %>)</h3>
          <table class="worktrees-table">
            <tbody>
              <% for (const wt of worktrees) { %>
                <tr>
                  <td>
                    <a href="<%= config.formatUrl(wt.subdomain + '.' + config.domain) %>" target="_blank">
                      <code><%= wt.branch_name %></code>
                    </a>
                  </td>
                  <td style="text-align: right;">
                    <%- include('partials/_action_btn', { id: wt.id, status: wt.status, btnClass: 'btn-sm' }) %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="build-logs-section hidden" id="build-logs-section">
        <h3>
          <button class="build-logs-toggle" id="build-logs-toggle" onclick="toggleBuildLogs()">Build Logs (click to expand)</button>
        </h3>
        <pre class="build-logs-output hidden" id="build-logs-output"></pre>
      </div>

      <div class="logs-section">
        <h3>Logs</h3>
        <div class="logs-tabs" id="logs-tabs">
          <button class="logs-tab active" data-log-id="<%= project.id %>" data-log-label="<%= project.name %>"><%= project.name %></button>
          <% for (const wt of worktrees) { %>
            <button class="logs-tab" data-log-id="<%= wt.id %>" data-log-label="<%= wt.branch_name %>"><%= wt.branch_name %></button>
          <% } %>
        </div>
        <pre class="logs-output" id="logs"><%= logs %></pre>
      </div>
    </div>
  </main>

  <script>
    const projectId = <%= project.id %>;
    let eventSource = null;

    var buildLines = [];

    function showBuildLog(content) {
      var section = document.getElementById('build-logs-section');
      var output = document.getElementById('build-logs-output');
      if (!section || !output) return;
      output.textContent = content;
      section.classList.remove('hidden');
      output.classList.remove('hidden');
      output.scrollTop = output.scrollHeight;
    }

    function toggleBuildLogs() {
      var output = document.getElementById('build-logs-output');
      var toggle = document.getElementById('build-logs-toggle');
      if (output.classList.contains('hidden')) {
        output.classList.remove('hidden');
        toggle.textContent = 'Build Logs (click to collapse)';
        output.scrollTop = output.scrollHeight;
      } else {
        output.classList.add('hidden');
        toggle.textContent = 'Build Logs (click to expand)';
      }
    }

    function subscribeStartup(id) {
      var badge = document.getElementById('status-indicator');
      var progress = document.getElementById('startup-progress');
      buildLines = [];
      if (badge) {
        badge.className = 'status-indicator starting';
        badge.textContent = 'STARTING...';
      }
      if (progress) progress.classList.remove('hidden');

      var es = new EventSource('/projects/' + id + '/startup');
      es.onmessage = function(e) {
        var data = JSON.parse(e.data);
        if (data.buildLine) {
          buildLines.push(data.buildLine);
        }
        if (data.step && data.totalSteps && progress) {
          progress.textContent = 'Step ' + data.step + '/' + data.totalSteps + ': ' + (data.label || '');
        }
        if (data.done && !data.error) {
          es.close();
          location.reload();
        }
        if (data.error) {
          es.close();
          if (progress) progress.textContent = data.error;
          var logContent = data.buildLog || buildLines.join('\n');
          if (logContent) showBuildLog(logContent);
          // Don't auto-reload on error — let user read the build log
        }
      };
      es.onerror = function() {
        es.close();
        if (buildLines.length > 0) showBuildLog(buildLines.join('\n'));
      };
    }

    async function startProject(id) {
      subscribeStartup(id);
      const res = await fetch(`/projects/${id}/start`, { method: 'POST' });
      if (!res.ok) {
        try {
          const data = await res.json();
          if (data.buildLog) showBuildLog(data.buildLog);
        } catch (_) {}
      }
    }

    async function stopProject(id, { reload = true } = {}) {
      const res = await fetch(`/projects/${id}/stop`, { method: 'POST' });
      if (res.ok) { if (reload) location.reload(); }
      else alert('Error stopping project');
      return res;
    }

    async function restartProject(id) {
      const res = await stopProject(id, { reload: false });
      if (res.ok) {
        setTimeout(() => startProject(id), 1000);
      }
    }

    async function deleteProject(id) {
      if (!confirm('Are you sure you want to delete this project?')) return;
      const res = await fetch(`/projects/${id}`, { method: 'DELETE' });
      if (res.ok) location.href = '/';
      else alert('Error deleting project');
    }

    // Tabbed log viewer
    var activeLogId = null;

    function switchLogTab(id) {
      var logsEl = document.getElementById('logs');

      // Disconnect existing stream
      if (eventSource) {
        eventSource.close();
        eventSource = null;
      }

      // Update active tab styling
      document.querySelectorAll('.logs-tab').forEach(function(tab) {
        tab.classList.toggle('active', tab.getAttribute('data-log-id') === String(id));
      });

      activeLogId = id;
      logsEl.textContent = 'Loading logs...';

      // Fetch history then stream
      fetch('/projects/' + id + '/logs?lines=200')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          logsEl.textContent = '';
          if (data.lines && data.lines.length > 0) {
            data.lines.forEach(function(l) {
              var span = document.createElement('span');
              span.textContent = l + '\n';
              logsEl.appendChild(span);
            });
            logsEl.scrollTop = logsEl.scrollHeight;
          } else {
            logsEl.textContent = 'No logs yet';
          }
          startLogStream(id);
        })
        .catch(function(err) {
          logsEl.textContent = 'Error loading logs: ' + err.message;
          startLogStream(id);
        });
    }

    function startLogStream(id) {
      if (eventSource) { eventSource.close(); eventSource = null; }
      var logsEl = document.getElementById('logs');

      eventSource = new EventSource('/projects/' + id + '/logs/stream');
      eventSource.onmessage = function(e) {
        if (activeLogId !== id) return;
        try {
          var data = JSON.parse(e.data);
          if (data.line) {
            if (logsEl.textContent === 'No logs yet') logsEl.textContent = '';
            var span = document.createElement('span');
            span.textContent = data.line + '\n';
            logsEl.appendChild(span);
            while (logsEl.childNodes.length > 1000) logsEl.removeChild(logsEl.childNodes[0]);
            logsEl.scrollTop = logsEl.scrollHeight;
          }
          if (data.closed) { eventSource.close(); eventSource = null; }
        } catch (_) {}
      };
      eventSource.onerror = function() {
        eventSource.close();
        eventSource = null;
      };
    }

    // Bind tab clicks
    document.querySelectorAll('.logs-tab').forEach(function(tab) {
      tab.addEventListener('click', function() {
        switchLogTab(parseInt(tab.getAttribute('data-log-id')));
      });
    });

    // Auto-stream main tab on load
    activeLogId = projectId;
    startLogStream(projectId);

    function toggleSettings() {
      var panel = document.getElementById('settings-panel');
      var btn = document.getElementById('settings-toggle');
      if (panel.classList.contains('hidden')) {
        panel.classList.remove('hidden');
        btn.textContent = 'hide settings';
      } else {
        panel.classList.add('hidden');
        btn.textContent = 'settings';
      }
    }

    async function saveSettings() {
      var feedback = document.getElementById('settings-feedback');
      var btn = document.getElementById('save-settings-btn');
      btn.disabled = true;
      feedback.textContent = '';
      feedback.className = 'settings-feedback';

      var body = {};
      var fields = ['override_build_command', 'override_start_command', 'override_docker_image'];
      for (var i = 0; i < fields.length; i++) {
        var val = document.getElementById(fields[i]).value.trim();
        body[fields[i]] = val || null;
      }
      var portVal = document.getElementById('override_port').value.trim();
      body.override_port = portVal ? parseInt(portVal, 10) : null;

      try {
        var res = await fetch('/api/projects/' + projectId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.ok) {
          feedback.textContent = 'Saved';
          feedback.className = 'settings-feedback success';
        } else {
          var data = await res.json();
          feedback.textContent = data.error || 'Error';
          feedback.className = 'settings-feedback error';
        }
      } catch (e) {
        feedback.textContent = e.message;
        feedback.className = 'settings-feedback error';
      }
      btn.disabled = false;
      setTimeout(function() { feedback.textContent = ''; }, 3000);
    }

    // Subscribe to startup progress if health is 'starting' on page load
    <% if (health === 'starting') { %>
    subscribeStartup(projectId);
    <% } %>

    // Load build log if project is unhealthy (failed)
    <% if (health === 'unhealthy') { %>
    fetch('/api/projects/' + projectId + '/build-log')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.buildLog) showBuildLog(data.buildLog);
      })
      .catch(function() {});
    <% } %>

  </script>
</body>
</html>
