<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.name %> - jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/_header') %>

  <main>
    <div class="panel project-detail">
      <div class="project-header">
        <h2><%= project.name %></h2>
        <% const health = project.health || 'unknown'; %>
        <span class="status-indicator <%= health === 'starting' ? 'starting' : health === 'healthy' ? 'running' : health === 'unhealthy' ? 'unhealthy' : project.status %>" id="status-indicator"><%=
          health === 'starting' ? 'STARTING...' :
          health === 'healthy' ? 'RUNNING' :
          health === 'unhealthy' ? 'FAILED' :
          project.status === 'running' ? 'RUNNING' : 'STOPPED'
        %></span>
        <span class="startup-progress hidden" id="startup-progress"></span>
      </div>

      <div class="project-info">
        <p><strong>Path:</strong> <code><%= project.path %></code></p>
        <p><strong>Subdomain:</strong>
          <% if (health === 'healthy') { %>
            <a href="<%= config.formatUrl(project.subdomain + '.' + config.domain) %>" target="_blank" id="subdomain-link">
              <%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %>
            </a>
          <% } else { %>
            <span id="subdomain-link"><%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %></span>
          <% } %>
        </p>
        <% if (project.port) { %>
          <p><strong>Port:</strong> <%= project.port %></p>
        <% } %>
        <% if (project.description) { %>
          <p><strong>Description:</strong> <%= project.description %></p>
        <% } %>
      </div>

      <div class="settings-section">
        <button class="nav-action settings-toggle" id="settings-toggle" onclick="toggleSettings()">settings</button>
        <div class="settings-panel hidden" id="settings-panel">
          <h3>Command Overrides</h3>
          <p class="settings-hint">Leave empty to use auto-detected values.</p>
          <div class="settings-form">
            <div class="form-group">
              <label class="label" for="override_build_command">Build Command</label>
              <input class="input" type="text" id="override_build_command"
                value="<%= project.override_build_command || '' %>"
                placeholder="<%= detection.installCommand || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_start_command">Start Command</label>
              <input class="input" type="text" id="override_start_command"
                value="<%= project.override_start_command || '' %>"
                placeholder="<%= detection.devCommand || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_port">Port</label>
              <input class="input" type="number" id="override_port"
                value="<%= project.override_port || '' %>"
                placeholder="<%= detection.port || 'auto-detect' %>">
            </div>
            <div class="form-group">
              <label class="label" for="override_docker_image">Docker Image</label>
              <input class="input" type="text" id="override_docker_image"
                value="<%= project.override_docker_image || '' %>"
                placeholder="<%= detection.dockerImage || 'auto-detect' %>">
            </div>
            <div class="settings-actions">
              <button class="btn" id="save-settings-btn" onclick="saveSettings()">Save</button>
              <span class="settings-feedback" id="settings-feedback"></span>
            </div>
          </div>
        </div>
      </div>

      <div class="project-actions">
        <% if (project.status === 'running') { %>
          <button class="btn btn-danger" onclick="stopProject(<%= project.id %>)">Stop</button>
          <button class="btn" onclick="restartProject(<%= project.id %>)">Restart</button>
        <% } else { %>
          <button class="btn btn-success" onclick="startProject(<%= project.id %>)">Start</button>
        <% } %>
        <button class="btn btn-danger-outline" onclick="deleteProject(<%= project.id %>)">Delete</button>
      </div>

      <% if (worktrees.length > 0) { %>
        <div class="worktrees-section">
          <h3>Worktrees (<%= worktrees.length %>)</h3>
          <table class="worktrees-table">
            <thead>
              <tr>
                <th class="label">Branch</th>
                <th class="label">URL</th>
                <th class="label">Status</th>
                <th class="label">Actions</th>
                <th class="label">Logs</th>
              </tr>
            </thead>
            <tbody>
              <% for (const wt of worktrees) { %>
                <tr>
                  <td><code><%= wt.branch_name %></code></td>
                  <td>
                    <% const wtHealth = wt.health || 'unknown'; %>
                    <% if (wtHealth === 'healthy') { %>
                      <a href="<%= config.formatUrl(wt.subdomain + '.' + config.domain) %>" target="_blank">
                        <%= config.formatUrl(wt.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %>
                      </a>
                    <% } else { %>
                      <%= config.formatUrl(wt.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %>
                    <% } %>
                  </td>
                  <td><span class="status-indicator <%= wtHealth === 'starting' ? 'starting' : wtHealth === 'healthy' ? 'running' : wtHealth === 'unhealthy' ? 'unhealthy' : wt.status %>"><%=
                    wtHealth === 'starting' ? 'STARTING...' :
                    wtHealth === 'healthy' ? 'RUNNING' :
                    wtHealth === 'unhealthy' ? 'FAILED' :
                    wt.status === 'running' ? 'RUNNING' : 'STOPPED'
                  %></span></td>
                  <td>
                    <%- include('partials/_action_btn', { id: wt.id, status: wt.status, btnClass: 'btn-sm' }) %>
                  </td>
                  <td>
                    <button class="btn btn-sm wt-logs-toggle" data-wt-id="<%= wt.id %>">logs</button>
                  </td>
                </tr>
                <tr class="wt-logs-row hidden" id="wt-logs-row-<%= wt.id %>">
                  <td colspan="5" style="padding: 0;">
                    <pre class="wt-logs-output" id="wt-log-output-<%= wt.id %>" style="max-height: 300px; overflow-y: auto; margin: 0; padding: 0.5rem; background: #1a1a1a; color: #ccc; font-size: 0.8rem; white-space: pre-wrap; word-wrap: break-word;">No logs yet</pre>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>

      <div class="logs-section">
        <h3>Logs</h3>
        <div class="logs-toolbar">
          <button class="btn btn-sm" onclick="refreshLogs()">Refresh</button>
          <button class="btn btn-sm" onclick="toggleStream()" id="stream-btn">Stream Live</button>
        </div>
        <pre id="logs"><%= logs %></pre>
      </div>
    </div>
  </main>

  <script>
    const projectId = <%= project.id %>;
    let eventSource = null;

    function subscribeStartup(id) {
      var badge = document.getElementById('status-indicator');
      var progress = document.getElementById('startup-progress');
      if (badge) {
        badge.className = 'status-indicator starting';
        badge.textContent = 'STARTING...';
      }
      if (progress) progress.classList.remove('hidden');

      var es = new EventSource('/projects/' + id + '/startup');
      es.onmessage = function(e) {
        var data = JSON.parse(e.data);
        if (data.step && data.totalSteps && progress) {
          progress.textContent = 'Step ' + data.step + '/' + data.totalSteps + ': ' + (data.label || '');
        }
        if (data.done && !data.error) {
          es.close();
          location.reload();
        }
        if (data.error) {
          es.close();
          if (progress) progress.textContent = data.error;
          setTimeout(function() { location.reload(); }, 2000);
        }
      };
      es.onerror = function() {
        es.close();
        setTimeout(function() { location.reload(); }, 2000);
      };
    }

    async function startProject(id) {
      subscribeStartup(id);
      const res = await fetch(`/projects/${id}/start`, { method: 'POST' });
      if (!res.ok) {
        alert('Error starting project');
      }
    }

    async function stopProject(id) {
      const res = await fetch(`/projects/${id}/stop`, { method: 'POST' });
      if (res.ok) location.reload();
      else alert('Error stopping project');
    }

    async function restartProject(id) {
      await stopProject(id);
      setTimeout(() => startProject(id), 1000);
    }

    async function deleteProject(id) {
      if (!confirm('Are you sure you want to delete this project?')) return;
      const res = await fetch(`/projects/${id}`, { method: 'DELETE' });
      if (res.ok) location.href = '/';
      else alert('Error deleting project');
    }

    async function refreshLogs() {
      location.reload();
    }

    function toggleStream() {
      const btn = document.getElementById('stream-btn');
      const logsEl = document.getElementById('logs');

      if (eventSource) {
        eventSource.close();
        eventSource = null;
        btn.textContent = 'Stream Live';
        return;
      }

      btn.textContent = 'Stop Stream';
      eventSource = new EventSource(`/projects/${projectId}/logs/stream`);
      
      eventSource.onmessage = (e) => {
        const data = JSON.parse(e.data);
        if (data.line) {
          logsEl.textContent += data.line + '\n';
          logsEl.scrollTop = logsEl.scrollHeight;
        }
        if (data.closed) {
          eventSource.close();
          eventSource = null;
          btn.textContent = 'Stream Live';
        }
      };

      eventSource.onerror = () => {
        eventSource.close();
        eventSource = null;
        btn.textContent = 'Stream Live';
      };
    }

    function toggleSettings() {
      var panel = document.getElementById('settings-panel');
      var btn = document.getElementById('settings-toggle');
      if (panel.classList.contains('hidden')) {
        panel.classList.remove('hidden');
        btn.textContent = 'hide settings';
      } else {
        panel.classList.add('hidden');
        btn.textContent = 'settings';
      }
    }

    async function saveSettings() {
      var feedback = document.getElementById('settings-feedback');
      var btn = document.getElementById('save-settings-btn');
      btn.disabled = true;
      feedback.textContent = '';
      feedback.className = 'settings-feedback';

      var body = {};
      var fields = ['override_build_command', 'override_start_command', 'override_docker_image'];
      for (var i = 0; i < fields.length; i++) {
        var val = document.getElementById(fields[i]).value.trim();
        body[fields[i]] = val || null;
      }
      var portVal = document.getElementById('override_port').value.trim();
      body.override_port = portVal ? parseInt(portVal, 10) : null;

      try {
        var res = await fetch('/api/projects/' + projectId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.ok) {
          feedback.textContent = 'Saved';
          feedback.className = 'settings-feedback success';
        } else {
          var data = await res.json();
          feedback.textContent = data.error || 'Error';
          feedback.className = 'settings-feedback error';
        }
      } catch (e) {
        feedback.textContent = e.message;
        feedback.className = 'settings-feedback error';
      }
      btn.disabled = false;
      setTimeout(function() { feedback.textContent = ''; }, 3000);
    }

    // Subscribe to startup progress if health is 'starting' on page load
    <% if (health === 'starting') { %>
    subscribeStartup(projectId);
    <% } %>

    // Worktree inline logs
    (function() {
      var wtStreams = {};

      function createWtLogger(wtId) {
        var row = document.getElementById('wt-logs-row-' + wtId);
        var output = document.getElementById('wt-log-output-' + wtId);
        var MAX_LINES = 1000;
        var es = null;
        var historyLoaded = false;
        var userScrolled = false;

        function isNearBottom() {
          return output.scrollHeight - output.scrollTop - output.clientHeight < 50;
        }

        function scrollToBottom() {
          output.scrollTop = output.scrollHeight;
        }

        output.addEventListener('scroll', function() {
          userScrolled = !isNearBottom();
        });

        function appendLine(text) {
          if (output.textContent === 'No logs yet') output.textContent = '';
          var line = document.createElement('span');
          line.textContent = text + '\n';
          output.appendChild(line);
          while (output.childNodes.length > MAX_LINES) {
            output.removeChild(output.childNodes[0]);
          }
          if (!userScrolled) scrollToBottom();
        }

        function startStream() {
          if (es) return;
          es = new EventSource('/projects/' + wtId + '/logs/stream');
          es.onmessage = function(e) {
            try {
              var data = JSON.parse(e.data);
              if (data.line) appendLine(data.line);
              if (data.closed) { es.close(); es = null; }
            } catch (_) {
              appendLine(e.data);
            }
          };
          es.onerror = function() {
            appendLine('[Connection lost, retrying...]');
          };
        }

        function stopStream() {
          if (es) { es.close(); es = null; }
        }

        return {
          open: function() {
            row.classList.remove('hidden');
            if (!historyLoaded) {
              historyLoaded = true;
              output.textContent = 'Loading logs...';
              fetch('/projects/' + wtId + '/logs?lines=200')
                .then(function(res) { return res.json(); })
                .then(function(data) {
                  output.textContent = '';
                  if (data.lines && data.lines.length > 0) {
                    data.lines.forEach(function(l) {
                      var span = document.createElement('span');
                      span.textContent = l + '\n';
                      output.appendChild(span);
                    });
                    scrollToBottom();
                  } else {
                    output.textContent = 'No logs yet';
                  }
                  startStream();
                })
                .catch(function(err) {
                  output.textContent = 'Error loading logs: ' + err.message;
                  startStream();
                });
            } else {
              startStream();
              if (!userScrolled) scrollToBottom();
            }
          },
          close: function() {
            row.classList.add('hidden');
            stopStream();
          },
          isOpen: function() { return !row.classList.contains('hidden'); }
        };
      }

      document.querySelectorAll('.wt-logs-toggle').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var wtId = btn.getAttribute('data-wt-id');
          if (!wtStreams[wtId]) wtStreams[wtId] = createWtLogger(wtId);
          var logger = wtStreams[wtId];
          if (logger.isOpen()) {
            logger.close();
            btn.textContent = 'logs';
          } else {
            logger.open();
            btn.textContent = 'hide';
          }
        });
      });
    })();
  </script>
</body>
</html>
