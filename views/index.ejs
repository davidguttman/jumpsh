<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦘</text></svg>">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
</head>
<body>
  <%- include('partials/_header') %>

  <div class="docker-warning" x-data="{ dockerAvailable: true }" x-init="
    async function checkDockerStatus() {
      try {
        const res = await fetch('/api/docker-status');
        const data = await res.json();
        dockerAvailable = data.available;
      } catch {}
    }
    checkDockerStatus();
    setInterval(checkDockerStatus, 30000);
  " x-show="!dockerAvailable" x-cloak>
    ⚠️ Docker not detected — start Docker to launch projects
  </div>

  <main x-data="projectList()" x-init="init()">
    <% if (projects.length === 0) { %>
      <div class="empty-state">
        <h2>No projects yet</h2>
        <p>Add your first project to get started.</p>
        <a href="/add" class="btn btn-primary">+ Add Project</a>
      </div>
    <% } else { %>
      <% if (projects.length >= 4) { %>
      <div class="controls-bar">
        <input class="input controls-filter" type="text" placeholder="filter projects..." x-model="filter" autocapitalize="off">
        <% if (projects.length >= 6) { %>
        <select class="input controls-sort" x-model="sort" x-on:change="$nextTick(() => {
          const list = $el.closest('main').querySelector('.project-list');
          const rows = [...list.querySelectorAll('[data-project-name]')];
          rows.sort((a, b) => {
            if (sort === 'status') return (a.dataset.projectStatus || '').localeCompare(b.dataset.projectStatus || '');
            return (a.dataset.projectName || '').localeCompare(b.dataset.projectName || '');
          });
          rows.forEach(row => list.appendChild(row));
        })">
          <option value="name">sort: name</option>
          <option value="status">sort: status</option>
        </select>
        <% } %>
      </div>
      <% } %>
      <div class="project-list">
        <% for (const project of projects) { %>
          <% const health = project.health || 'unknown'; %>
          <% const worktrees = worktreesByParent[project.id] || []; %>
          <div class="panel project-row <%= project.status %>"
               :class="{ expanded: expanded === '<%= project.name %>' }"
               data-project-name="<%= project.name %>"
               data-project-status="<%= project.status %>"
               x-show="expanded === '<%= project.name %>' || !filter || '<%= project.name.toLowerCase() %>'.includes(filter.toLowerCase())">
            <% if (projects.length > 1) { %>
              <a href="#" class="expand-toggle" aria-label="Toggle <%= project.name %>"
                 @click.prevent="toggle('<%= project.name %>', '<%= project.id %>')"
                 x-html="expanded === '<%= project.name %>' ? '&#x25BC;' : '&#x25B6;'"></a>
            <% } %>
            <span class="project-row-name"><%= project.name %></span>
            <span class="project-row-url">
              <% if (health === 'healthy') { %>
                <a href="<%= config.formatUrl(project.subdomain + '.' + config.domain) %>" target="_blank"><%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %></a>
              <% } else { %>
                <span class="url-inactive"><%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %></span>
              <% } %>
            </span>
            <%- include('partials/_action_btn', { id: project.id, status: project.status }) %>
            <% if (worktrees.length > 0) { %>
              <span class="project-row-worktrees">
                <% for (const wt of worktrees) { %>
                  <% const wtHealth = wt.health || 'unknown'; %>
                  <% if (wtHealth === 'healthy') { %>
                    <a href="<%= config.formatUrl(wt.subdomain + '.' + config.domain) %>" target="_blank" class="wt-chip"><%= wt.branch_name %></a>
                  <% } else { %>
                    <span class="wt-chip wt-chip-inactive"><%= wt.branch_name %></span>
                  <% } %>
                <% } %>
              </span>
            <% } %>
            <div class="project-row-detail"
                 x-show="expanded === '<%= project.name %>'"
                 x-html="detailCache['<%= project.name %>'] || ''">
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>

  <script>
    function projectList() {
      return {
        filter: '',
        sort: 'name',
        expanded: null,
        loading: null,
        detailCache: {},

        init() {
          // Read initial expand from server-side or URL
          var initialExpand = <%- JSON.stringify(expandName) %>;
          var singleProject = <%- projects.length === 1 ? JSON.stringify(projects[0].name) : 'null' %>;
          var projectIds = <%- JSON.stringify(projects.reduce(function(m, p) { m[p.name] = p.id; return m; }, {})) %>;
          this._projectIds = projectIds;
          this._singleProject = singleProject;

          var expandTarget = initialExpand || singleProject;
          if (expandTarget && projectIds[expandTarget]) {
            this.toggle(expandTarget, projectIds[expandTarget]);
          }
        },

        async toggle(name, id) {
          // Collapse if already expanded
          if (this.expanded === name) {
            // Don't collapse if single project
            if (this._singleProject) return;
            this.expanded = null;
            this._cleanupDetail(name);
            history.replaceState(null, '', '/');
            return;
          }

          // Clean up previous expanded
          if (this.expanded) {
            this._cleanupDetail(this.expanded);
          }

          // If cached, just expand
          if (this.detailCache[name]) {
            this.expanded = name;
            this._updateUrl(name);
            this.$nextTick(() => {
              this._activateScripts(name);
              this._scrollToProject(name);
            });
            return;
          }

          // Fetch detail partial
          this.loading = name;
          try {
            var res = await fetch('/projects/' + id + '/detail-partial');
            if (!res.ok) throw new Error('Failed to load');
            var html = await res.text();
            this.detailCache[name] = html;
            this.expanded = name;
            this.loading = null;
            this._updateUrl(name);
            this.$nextTick(() => {
              this._activateScripts(name);
              this._scrollToProject(name);
            });
          } catch (err) {
            this.loading = null;
            console.error('Error loading detail for ' + name + ':', err);
          }
        },

        _updateUrl(name) {
          var url = new URL(window.location);
          url.searchParams.set('expand', name);
          history.replaceState(null, '', url.toString());
        },

        _scrollToProject(name) {
          var el = document.querySelector('[data-project-name="' + name + '"]');
          if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        },

        _activateScripts(name) {
          // Find the detail container and re-create script tags so the browser executes them
          var row = document.querySelector('[data-project-name="' + name + '"]');
          if (!row) return;
          var detail = row.querySelector('.project-row-detail');
          if (!detail) return;
          var scripts = detail.querySelectorAll('script');
          scripts.forEach(function(oldScript) {
            var newScript = document.createElement('script');
            if (oldScript.src) {
              newScript.src = oldScript.src;
            } else {
              newScript.textContent = oldScript.textContent;
            }
            oldScript.parentNode.replaceChild(newScript, oldScript);
          });
        },

        _cleanupDetail(name) {
          // Close any EventSources from the detail partial
          var row = document.querySelector('[data-project-name="' + name + '"]');
          if (!row) return;
          var id = this._projectIds[name];
          if (id && window._pd && window._pd[id]) {
            if (window._pd[id].eventSource) {
              window._pd[id].eventSource.close();
              window._pd[id].eventSource = null;
            }
            delete window._pd[id];
          }
          // Clear cache so re-expand fetches fresh data
          delete this.detailCache[name];
        }
      };
    }

    // Lightweight startup subscription for list-view action buttons
    function _listSubscribeStartup(id, btn) {
      var es = new EventSource('/projects/' + id + '/startup');
      es.onmessage = function(e) {
        var data = JSON.parse(e.data);
        if (data.step && data.totalSteps) {
          btn.textContent = 'Step ' + data.step + '/' + data.totalSteps;
        }
        if (data.done && !data.error) { es.close(); location.reload(); }
        if (data.error) { es.close(); btn.disabled = false; btn.textContent = 'Start'; }
      };
      es.onerror = function() { es.close(); setTimeout(function() { location.reload(); }, 2000); };
    }

    // List-view start/stop: use event.target for button feedback.
    // The detail partial may define richer versions of startProject/stopProject;
    // these only apply if the partial hasn't already defined them.
    if (!window.startProject) {
      window.startProject = async function(id) {
        var btn = event.target;
        btn.disabled = true;
        btn.textContent = 'Starting...';
        _listSubscribeStartup(id, btn);
        try {
          var res = await fetch('/projects/' + id + '/start', { method: 'POST' });
          if (!res.ok) {
            var data = await res.json();
            alert('Error: ' + data.error);
            btn.disabled = false;
            btn.textContent = 'Start';
          }
        } catch (err) {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'Start';
        }
      };
    }

    if (!window.stopProject) {
      window.stopProject = async function(id) {
        var btn = event.target;
        btn.disabled = true;
        btn.textContent = 'Stopping...';
        try {
          var res = await fetch('/projects/' + id + '/stop', { method: 'POST' });
          if (res.ok) { location.reload(); }
          else {
            var data = await res.json();
            alert('Error: ' + data.error);
            btn.disabled = false;
            btn.textContent = 'Stop';
          }
        } catch (err) {
          alert('Error: ' + err.message);
          btn.disabled = false;
          btn.textContent = 'Stop';
        }
      };
    }

    // Auto-refresh every 30 seconds (only when no project is expanded)
    setInterval(function() {
      if (!document.querySelector('.project-row.expanded')) {
        location.reload();
      }
    }, 30000);

    // Subscribe to startup progress for all projects currently starting
    <% for (const project of projects) { %>
      <% if (project.health === 'starting') { %>
    (function() {
      var btn = document.getElementById('project-btn-<%= project.id %>');
      if (btn) { btn.disabled = true; btn.textContent = 'Starting...'; _listSubscribeStartup('<%= project.id %>', btn); }
    })();
      <% } %>
    <% } %>
    <% for (const wts of Object.values(worktreesByParent)) { %>
      <% for (const wt of wts) { %>
        <% if (wt.health === 'starting') { %>
    (function() {
      var btn = document.getElementById('project-btn-<%= wt.id %>');
      if (btn) { btn.disabled = true; btn.textContent = 'Starting...'; _listSubscribeStartup('<%= wt.id %>', btn); }
    })();
        <% } %>
      <% } %>
    <% } %>
  </script>
</body>
</html>
