<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a href="/">jump.sh</a></h1>
    <nav>
      <a href="/add">+ add project</a>
    </nav>
  </header>

  <main>
    <% if (projects.length === 0) { %>
      <div class="empty-state">
        <h2>No projects yet</h2>
        <p>Add your first project to get started.</p>
        <a href="/add" class="btn btn-primary">+ Add Project</a>
      </div>
    <% } else { %>
      <div class="project-grid">
        <% for (const project of projects) { %>
          <% const health = project.health || 'unknown'; %>
          <div class="project-card <%= project.status %>">
            <div class="project-header">
              <h2><a href="/projects/<%= project.id %>"><%= project.name %></a></h2>
              <a href="/projects/<%= project.id %>" class="detail-link">detail</a>
            </div>


            <div class="project-url">
              <% if (health === 'healthy') { %>
                <a href="<%= config.formatUrl(project.subdomain + '.' + config.domain) %>" target="_blank">
                  <%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %>
                </a>
              <% } else { %>
                <span class="url-inactive"><%= config.formatUrl(project.subdomain + '.' + config.domain).replace(/^https?:\/\//, '') %></span>
              <% } %>
              <% if (project.status === 'running') { %>
                <button class="btn btn-danger" id="project-btn-<%= project.id %>" onclick="stopProject(<%= project.id %>)">Stop</button>
              <% } else { %>
                <button class="btn btn-success" id="project-btn-<%= project.id %>" onclick="startProject(<%= project.id %>)">Start</button>
              <% } %>
            </div>

            <% const worktrees = worktreesByParent[project.id] || []; %>
            <% if (worktrees.length > 0) { %>
              <div class="worktrees">
                <h4>Worktrees (<%= worktrees.length %>)</h4>
                <ul>
                  <% for (const wt of worktrees) { %>
                    <% const wtHealth = wt.health || 'unknown'; %>
                    <li class="<%= wt.status %>">
                      <% if (wtHealth === 'healthy') { %>
                        <a href="<%= config.formatUrl(wt.subdomain + '.' + config.domain) %>" target="_blank" class="wt-branch-link"><%= wt.branch_name %></a>
                      <% } else { %>
                        <span class="wt-branch-name"><%= wt.branch_name %></span>
                      <% } %>
                      <% if (wt.status === 'running') { %>
                        <button class="btn btn-danger btn-sm" id="project-btn-<%= wt.id %>" onclick="stopProject(<%= wt.id %>)">Stop</button>
                      <% } else { %>
                        <button class="btn btn-success btn-sm" id="project-btn-<%= wt.id %>" onclick="startProject(<%= wt.id %>)">Start</button>
                      <% } %>
                    </li>
                  <% } %>
                </ul>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>

  <script>
    function subscribeStartup(id, btn) {
      var es = new EventSource('/projects/' + id + '/startup');
      es.onmessage = function(e) {
        var data = JSON.parse(e.data);
        if (data.step && data.totalSteps) {
          btn.textContent = 'Step ' + data.step + '/' + data.totalSteps;
        }
        if (data.done && !data.error) {
          es.close();
          location.reload();
        }
        if (data.error) {
          es.close();
          btn.disabled = false;
          btn.textContent = 'Start';
        }
      };
      es.onerror = function() {
        es.close();
        setTimeout(function() { location.reload(); }, 2000);
      };
    }

    async function startProject(id) {
      const btn = event.target;
      btn.disabled = true;
      btn.textContent = 'Starting...';

      subscribeStartup(id, btn);

      try {
        const res = await fetch(`/projects/${id}/start`, { method: 'POST' });
        if (!res.ok) {
          const data = await res.json();
          alert('Error: ' + data.error);
          btn.disabled = false;
          btn.textContent = 'Start';
        }
      } catch (err) {
        alert('Error: ' + err.message);
        btn.disabled = false;
        btn.textContent = 'Start';
      }
    }

    async function stopProject(id) {
      const btn = event.target;
      btn.disabled = true;
      btn.textContent = 'Stopping...';

      try {
        const res = await fetch(`/projects/${id}/stop`, { method: 'POST' });
        if (res.ok) {
          location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + data.error);
          btn.disabled = false;
          btn.textContent = 'Stop';
        }
      } catch (err) {
        alert('Error: ' + err.message);
        btn.disabled = false;
        btn.textContent = 'Stop';
      }
    }

    // Auto-refresh every 30 seconds
    setTimeout(() => location.reload(), 30000);

    // Subscribe to startup progress for all projects currently starting
    <% for (const project of projects) { %>
      <% if (project.health === 'starting') { %>
    (function() {
      var btn = document.getElementById('project-btn-<%= project.id %>');
      if (btn) { btn.disabled = true; btn.textContent = 'Starting...'; subscribeStartup('<%= project.id %>', btn); }
    })();
      <% } %>
    <% } %>
    <% for (const wts of Object.values(worktreesByParent)) { %>
      <% for (const wt of wts) { %>
        <% if (wt.health === 'starting') { %>
    (function() {
      var btn = document.getElementById('project-btn-<%= wt.id %>');
      if (btn) { btn.disabled = true; btn.textContent = 'Starting...'; subscribeStartup('<%= wt.id %>', btn); }
    })();
        <% } %>
      <% } %>
    <% } %>
  </script>
</body>
</html>
