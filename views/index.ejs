<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦘</text></svg>">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
</head>
<body>
  <%- include('partials/_header') %>

  <% if (config.devMode) { %>
  <div class="dev-mode-banner">DEV MODE &mdash; Using mock containers</div>
  <% } %>

  <main x-data="projectList()" x-init="init()">
    <% if (projects.length === 0) { %>
      <div class="empty-state">
        <h2>No projects yet</h2>
        <p>Add your first project to get started.</p>
        <a href="/add" class="btn btn-primary">+ Add Project</a>
      </div>
    <% } else { %>
      <% if (projects.length >= 4) { %>
      <div class="controls-bar">
        <input class="input controls-filter" type="text" placeholder="filter projects..." x-model="filter" autocapitalize="off">
        <% if (projects.length >= 6) { %>
        <select class="input controls-sort" x-model="sort" x-on:change="$nextTick(() => {
          localStorage.setItem('jumpsh-sort', sort);
          const list = $el.closest('main').querySelector('.project-list');
          const rows = [...list.querySelectorAll('[data-project-name]')];
          rows.sort((a, b) => {
            if (sort === 'status') return (a.dataset.projectStatus || '').localeCompare(b.dataset.projectStatus || '');
            return (a.dataset.projectName || '').localeCompare(b.dataset.projectName || '');
          });
          rows.forEach(row => list.appendChild(row));
        })">
          <option value="name">sort: name</option>
          <option value="status">sort: status</option>
        </select>
        <% } %>
      </div>
      <% } %>
      <div class="project-list">
        <% for (const project of projects) { %>
          <% const health = project.health || 'unknown'; %>
          <% const worktrees = worktreesByParent[project.id] || []; %>
          <div class="panel project-row <%= project.status %>"
               :class="{ expanded: expanded === '<%= project.name %>' }"
               data-project-name="<%= project.name %>"
               data-project-id="<%= project.id %>"
               data-project-status="<%= project.status %>"
               x-show="expanded === '<%= project.name %>' || !filter || '<%= project.name.toLowerCase() %>'.includes(filter.toLowerCase())">
            <% if (projects.length > 1) { %>
              <a href="#" class="expand-toggle" aria-label="Toggle <%= project.name %>"
                 @click.prevent="toggle('<%= project.name %>', '<%= project.id %>')"
                 x-html="expanded === '<%= project.name %>' ? '&#x25BC;' : '&#x25B6;'"></a>
            <% } %>
            <span class="project-row-name"><%= project.name %></span>
            <% if (project.name.startsWith('fixture-')) { %>
              <span class="badge badge-fixture">fixture</span>
            <% } %>
            <span class="project-row-url">
              <% if (health === 'healthy') { %>
                <a href="<%= config.projectUrl(project.subdomain) %>" target="_blank"><%= config.projectUrl(project.subdomain).replace(/^https?:\/\//, '') %></a>
              <% } else { %>
                <span class="url-inactive"><%= config.projectUrl(project.subdomain).replace(/^https?:\/\//, '') %></span>
              <% } %>
            </span>
            <% if (worktrees.length > 0) { %>
              <span class="project-row-worktrees">
                <% for (let i = 0; i < Math.min(worktrees.length, 3); i++) { const wt = worktrees[i]; %>
                  <% const wtHealth = wt.health || 'unknown'; %>
                  <% if (wtHealth === 'healthy') { %>
                    <a href="<%= config.projectUrl(wt.subdomain) %>" target="_blank" class="wt-chip" data-project-worktree-chip="<%= wt.id %>" data-project-worktree-url="<%= config.projectUrl(wt.subdomain) %>"><%= wt.branch_name %></a>
                  <% } else { %>
                    <span class="wt-chip wt-chip-inactive" data-project-worktree-chip="<%= wt.id %>" data-project-worktree-url="<%= config.projectUrl(wt.subdomain) %>"><%= wt.branch_name %></span>
                  <% } %>
                <% } %>
                <% if (worktrees.length > 3) { %>
                  <a href="#" class="wt-chip wt-chip-more" @click.prevent="toggle('<%= project.name %>', '<%= project.id %>')">+<%= worktrees.length - 3 %> more</a>
                <% } %>
              </span>
            <% } %>
            <%- include('partials/_action_btn', { id: project.id, status: project.status }) %>
            <span class="project-row-status hidden" id="project-status-msg-<%= project.id %>" role="status" aria-live="polite"></span>
            <div class="project-row-detail"
                 x-show="expanded === '<%= project.name %>'"
                 x-html="detailCache['<%= project.name %>'] || ''">
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>

  <script>
    function projectList() {
      return {
        filter: '',
        sort: 'name',
        expanded: null,
        loading: null,
        detailCache: {},

        init() {
          // Read initial expand from server-side or URL
          var initialExpand = <%- JSON.stringify(expandName) %>;
          var singleProject = <%- projects.length === 1 ? JSON.stringify(projects[0].name) : 'null' %>;
          var projectIds = <%- JSON.stringify(projects.reduce(function(m, p) { m[p.name] = p.id; return m; }, {})) %>;
          this._projectIds = projectIds;
          this._singleProject = singleProject;

          // Restore persisted sort preference
          var savedSort = localStorage.getItem('jumpsh-sort');
          if (savedSort && (savedSort === 'name' || savedSort === 'status')) {
            this.sort = savedSort;
            this.$nextTick(() => {
              var list = this.$el.querySelector('.project-list');
              if (list) {
                var rows = [...list.querySelectorAll('[data-project-name]')];
                rows.sort((a, b) => {
                  if (savedSort === 'status') return (a.dataset.projectStatus || '').localeCompare(b.dataset.projectStatus || '');
                  return (a.dataset.projectName || '').localeCompare(b.dataset.projectName || '');
                });
                rows.forEach(row => list.appendChild(row));
              }
            });
          }

          var expandTarget = initialExpand || singleProject;
          if (expandTarget && projectIds[expandTarget]) {
            this.toggle(expandTarget, projectIds[expandTarget]);
          }
        },

        async toggle(name, id) {
          // Collapse if already expanded
          if (this.expanded === name) {
            // Don't collapse if single project
            if (this._singleProject) return;
            this.expanded = null;
            this._cleanupDetail(name);
            history.replaceState(null, '', '/');
            return;
          }

          // Clean up previous expanded
          if (this.expanded) {
            this._cleanupDetail(this.expanded);
          }

          // If cached, just expand
          if (this.detailCache[name]) {
            this.expanded = name;
            this._updateUrl(name);
            this.$nextTick(() => {
              this._activateScripts(name);
              this._scrollToProject(name);
            });
            return;
          }

          // Fetch detail partial
          this.loading = name;
          showProjectRowStatus(id, 'Loading details...', false);
          try {
            var res = await fetch('/projects/' + id + '/detail-partial');
            if (!res.ok) throw new Error('Failed to load details (' + res.status + ')');
            var html = await res.text();
            this.detailCache[name] = html;
            this.expanded = name;
            this.loading = null;
            clearProjectRowStatus(id);
            this._updateUrl(name);
            this.$nextTick(() => {
              this._activateScripts(name);
              this._scrollToProject(name);
            });
          } catch (err) {
            this.loading = null;
            showProjectRowStatus(id, 'Could not load details: ' + errorMessage(err), true);
            refreshProjectStatus(id, { reason: 'detail load failed', retry: true });
            console.error('Error loading detail for ' + name + ':', err);
          }
        },

        _updateUrl(name) {
          var url = new URL(window.location);
          url.searchParams.set('expand', name);
          history.replaceState(null, '', url.toString());
        },

        _scrollToProject(name) {
          var el = document.querySelector('[data-project-name="' + name + '"]');
          if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        },

        _activateScripts(name) {
          // Find the detail container and re-create script tags so the browser executes them
          var row = document.querySelector('[data-project-name="' + name + '"]');
          if (!row) return;
          var detail = row.querySelector('.project-row-detail');
          if (!detail) return;
          var scripts = detail.querySelectorAll('script');
          scripts.forEach(function(oldScript) {
            var newScript = document.createElement('script');
            if (oldScript.src) {
              newScript.src = oldScript.src;
            } else {
              newScript.textContent = oldScript.textContent;
            }
            oldScript.parentNode.replaceChild(newScript, oldScript);
          });
        },

        _cleanupDetail(name) {
          // Close any EventSources and timers from the detail partial
          var row = document.querySelector('[data-project-name="' + name + '"]');
          if (!row) return;
          var id = this._projectIds[name];
          if (id && window._pd && window._pd[id]) {
            if (window._pd[id].eventSource) {
              window._pd[id].eventSource.close();
              window._pd[id].eventSource = null;
            }
            if (window._pd[id].wtRecencyTimer) {
              clearInterval(window._pd[id].wtRecencyTimer);
              window._pd[id].wtRecencyTimer = null;
            }
            delete window._pd[id];
          }
          // Clear cache so re-expand fetches fresh data
          delete this.detailCache[name];
        }
      };
    }

    function errorMessage(err) {
      return (err && err.message) ? err.message : String(err || 'Unknown error');
    }

    function projectButtons(id) {
      return Array.prototype.slice.call(document.querySelectorAll('[data-project-action-btn="' + id + '"]'));
    }

    function rowForProject(id) {
      return document.querySelector('.project-row[data-project-id="' + id + '"]');
    }

    function detailActionsForProject(id) {
      return document.querySelector('[data-project-detail-actions="' + id + '"]');
    }

    function statusElForProject(id) {
      var el = document.getElementById('project-status-msg-' + id);
      if (el) return el;
      var row = rowForProject(id);
      if (!row) return null;
      el = document.createElement('span');
      el.id = 'project-status-msg-' + id;
      el.className = 'project-row-status hidden';
      el.setAttribute('role', 'status');
      el.setAttribute('aria-live', 'polite');
      row.appendChild(el);
      return el;
    }

    function showProjectRowStatus(id, message, isError) {
      var el = statusElForProject(id);
      if (!el) return;
      el.textContent = message || '';
      el.className = 'project-row-status' + (isError ? ' error' : '');
      if (!message) el.classList.add('hidden');
    }

    function showProjectDetailStatus(id, message, isError) {
      var el = document.getElementById('project-detail-status-' + id);
      if (!el) return;
      el.textContent = message || '';
      el.className = 'project-detail-status' + (isError ? ' error' : '');
      if (!message) el.classList.add('hidden');
    }

    function showProjectFeedback(id, message, isError) {
      showProjectRowStatus(id, message, isError);
      showProjectDetailStatus(id, message, isError);
    }

    function clearProjectRowStatus(id) {
      showProjectRowStatus(id, '', false);
    }

    function clearProjectFeedback(id) {
      showProjectRowStatus(id, '', false);
      showProjectDetailStatus(id, '', false);
    }

    function updateRowStatusClass(id, status) {
      var row = rowForProject(id);
      if (!row || !status) return;
      row.dataset.projectStatus = status;
      row.classList.remove('running', 'stopped', 'starting');
      row.classList.add(status);
    }

    function updateWorktreeChips(snapshot) {
      if (!snapshot || !snapshot.isWorktree) return;
      var chips = Array.prototype.slice.call(document.querySelectorAll('[data-project-worktree-chip="' + snapshot.id + '"]'));
      if (chips.length === 0) return;
      var isHealthy = snapshot.health === 'healthy';
      chips.forEach(function(chip) {
        var tag = (chip.tagName || '').toLowerCase();
        var text = chip.textContent;
        var url = snapshot.url || chip.getAttribute('data-project-worktree-url') || '';
        var next = chip;
        if (isHealthy && url && tag !== 'a') {
          next = document.createElement('a');
          next.href = url;
          next.setAttribute('target', '_blank');
          chip.replaceWith(next);
        } else if ((!isHealthy || !url) && tag === 'a') {
          next = document.createElement('span');
          chip.replaceWith(next);
        }
        next.textContent = text;
        next.className = 'wt-chip' + (isHealthy && url ? '' : ' wt-chip-inactive');
        next.setAttribute('data-project-worktree-chip', snapshot.id);
        if (url) next.setAttribute('data-project-worktree-url', url);
        if (isHealthy && url && next.tagName && next.tagName.toLowerCase() === 'a') {
          next.href = url;
          next.setAttribute('href', url);
        }
      });
    }

    function fallbackActionButtonHtml(id, status, useSmallButton) {
      var extra = useSmallButton ? ' btn-sm' : '';
      if (status === 'running') {
        return '<button class="btn btn-danger' + extra + '" id="project-btn-' + id + '" data-project-action-btn="' + id + '" data-project-status="running" onclick="stopProject(' + id + ')">Stop</button>';
      }
      if (status === 'starting') {
        return '<button class="btn btn-success' + extra + '" id="project-btn-' + id + '" data-project-action-btn="' + id + '" data-project-status="starting" disabled aria-busy="true">Starting...</button>';
      }
      return '<button class="btn btn-success' + extra + '" id="project-btn-' + id + '" data-project-action-btn="' + id + '" data-project-status="stopped" onclick="startProject(' + id + ')">Start</button>';
    }

    function detailActionHtml(id, status, actionHtml) {
      var statusEl = document.getElementById('project-detail-status-' + id);
      var statusHtml = statusEl ? statusEl.outerHTML : '<span class="project-detail-status hidden" id="project-detail-status-' + id + '" role="status" aria-live="polite"></span>';
      var html = statusHtml;
      if (status === 'running') html += '<button class="btn" onclick="restartProject(' + id + ')">Restart</button>';
      html += actionHtml || fallbackActionButtonHtml(id, status, false);
      return html;
    }

    function updateDetailActions(id, status, actionHtml) {
      var actions = detailActionsForProject(id);
      if (!actions) return;
      actions.innerHTML = detailActionHtml(id, status, actionHtml);
    }

    function replaceProjectButtons(id, status, actionHtml) {
      var buttons = projectButtons(id);
      buttons.forEach(function(btn) {
        var wrapper = document.createElement('span');
        wrapper.innerHTML = actionHtml || fallbackActionButtonHtml(id, status, btn.classList.contains('btn-sm'));
        var next = wrapper.firstElementChild;
        if (next && btn.classList.contains('btn-sm') && !next.classList.contains('btn-sm')) next.classList.add('btn-sm');
        if (next) btn.replaceWith(next);
      });
      updateDetailActions(id, status, actionHtml);
    }

    function setProjectButtonBusy(id, label) {
      projectButtons(id).forEach(function(btn) {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = label;
      });
    }

    function enableProjectButtonFallback(id, status) {
      replaceProjectButtons(id, status || 'stopped');
      updateRowStatusClass(id, status || 'stopped');
    }

    async function parseJsonResponse(res) {
      var data = {};
      try { data = await res.json(); } catch (_) {}
      if (!res.ok) {
        var err = new Error(data.error || ('Request failed (' + res.status + ')'));
        err.responseData = data;
        err.status = res.status;
        throw err;
      }
      return data;
    }

    function showProjectBuildLog(id, content) {
      if (!content) return;
      var section = document.getElementById('build-logs-section-' + id);
      var output = document.getElementById('build-logs-output-' + id);
      if (!section || !output) return;
      output.textContent = content;
      section.classList.remove('hidden');
      output.classList.remove('hidden');
      output.scrollTop = output.scrollHeight;
    }

    function showBuildLogFromResponse(id, data) {
      if (data && data.buildLog) showProjectBuildLog(id, data.buildLog);
    }

    function statusSnapshotsFromResponse(data) {
      if (!data) return [];
      if (Array.isArray(data.related) && data.related.length > 0) return data.related;
      return [data];
    }

    function reconcileProjectStatusSnapshot(snapshot) {
      if (!snapshot || typeof snapshot.id === 'undefined') return;
      replaceProjectButtons(snapshot.id, snapshot.status, snapshot.actionHtml);
      updateRowStatusClass(snapshot.id, snapshot.status);
      updateWorktreeChips(snapshot);
      clearProjectRowStatus(snapshot.id);
      if (snapshot.status === 'starting' && projectButtons(snapshot.id).length > 0) subscribeProjectStartup(snapshot.id);
    }

    function reconcileProjectStatuses(data) {
      var snapshots = statusSnapshotsFromResponse(data);
      snapshots.forEach(reconcileProjectStatusSnapshot);
      return snapshots;
    }

    async function refreshProjectStatus(id, opts) {
      opts = opts || {};
      try {
        var res = await fetch('/api/projects/' + id + '/status', { headers: { 'Accept': 'application/json' } });
        var data = await parseJsonResponse(res);
        reconcileProjectStatuses(data);
        return data;
      } catch (err) {
        showProjectFeedback(id, 'Could not refresh status' + (opts.reason ? ' after ' + opts.reason : '') + ': ' + errorMessage(err), true);
        if (opts.retry) {
          setTimeout(function() { refreshProjectStatus(id, { reason: 'retry', fallbackStatus: opts.fallbackStatus }); }, opts.retryDelay || 2000);
        }
        if (opts.fallbackStatus) enableProjectButtonFallback(id, opts.fallbackStatus);
        return null;
      }
    }

    window._projectStartupStreams = window._projectStartupStreams || {};
    window._projectStartupBuildLines = window._projectStartupBuildLines || {};
    function updateDetailStartupProgress(id, data) {
      var badge = document.getElementById('status-indicator-' + id);
      var progress = document.getElementById('startup-progress-' + id);
      if (badge) {
        badge.className = data.error ? 'status-indicator unhealthy' : 'status-indicator starting';
        badge.textContent = data.error ? 'ERROR' : 'STARTING...';
      }
      if (progress) {
        progress.classList.remove('hidden');
        if (data.step && data.totalSteps) progress.textContent = 'Step ' + data.step + '/' + data.totalSteps + ': ' + (data.label || '');
        if (data.error) progress.textContent = data.error;
      }
    }

    function subscribeProjectStartup(id) {
      if (window._projectStartupStreams[id]) return window._projectStartupStreams[id];
      if (projectButtons(id).length === 0) return null;
      window._projectStartupBuildLines[id] = [];
      var es = new EventSource('/projects/' + id + '/startup');
      window._projectStartupStreams[id] = es;
      es.onmessage = function(e) {
        var data = JSON.parse(e.data);
        if (data.buildLine) window._projectStartupBuildLines[id].push(data.buildLine);
        updateDetailStartupProgress(id, data);
        if (data.step && data.totalSteps) {
          setProjectButtonBusy(id, 'Step ' + data.step + '/' + data.totalSteps);
          showProjectFeedback(id, data.label ? 'Starting: ' + data.label : 'Starting...', false);
        }
        if (data.done && !data.error) {
          es.close();
          delete window._projectStartupStreams[id];
          delete window._projectStartupBuildLines[id];
          refreshProjectStatus(id, { reason: 'startup completed', retry: true, fallbackStatus: 'running' });
        }
        if (data.error) {
          es.close();
          delete window._projectStartupStreams[id];
          showProjectBuildLog(id, data.buildLog || (window._projectStartupBuildLines[id] || []).join('\n'));
          delete window._projectStartupBuildLines[id];
          showProjectFeedback(id, 'Startup failed: ' + data.error, true);
          refreshProjectStatus(id, { reason: 'startup failed', retry: true, fallbackStatus: 'stopped' });
        }
      };
      es.onerror = function() {
        es.close();
        delete window._projectStartupStreams[id];
        showProjectBuildLog(id, (window._projectStartupBuildLines[id] || []).join('\n'));
        delete window._projectStartupBuildLines[id];
        showProjectFeedback(id, 'Startup status connection lost; refreshing...', true);
        refreshProjectStatus(id, { reason: 'startup stream disconnected', retry: true, fallbackStatus: 'stopped' });
      };
      return es;
    }

    async function postProjectLifecycle(id, action) {
      var res = await fetch('/projects/' + id + '/' + action, { method: 'POST', headers: { 'Accept': 'application/json' } });
      return parseJsonResponse(res);
    }

    window.startProject = async function(id) {
      clearProjectFeedback(id);
      showProjectDetailStatus(id, 'Starting...', false);
      setProjectButtonBusy(id, 'Starting...');
      subscribeProjectStartup(id);
      try {
        var data = await postProjectLifecycle(id, 'start');
        if (data.status) {
          reconcileProjectStatusSnapshot({ id: id, status: data.status, health: data.health });
        }
        refreshProjectStatus(id, { reason: 'start request', retry: true, fallbackStatus: data.status || 'starting' });
        return data;
      } catch (err) {
        showBuildLogFromResponse(id, err.responseData);
        showProjectFeedback(id, 'Start failed: ' + errorMessage(err), true);
        refreshProjectStatus(id, { reason: 'start failure', retry: true, fallbackStatus: 'stopped' });
        return { ok: false, error: err };
      }
    };

    window.stopProject = async function(id, opts) {
      opts = opts || {};
      clearProjectFeedback(id);
      showProjectDetailStatus(id, 'Stopping...', false);
      setProjectButtonBusy(id, 'Stopping...');
      try {
        var data = await postProjectLifecycle(id, 'stop');
        showProjectDetailStatus(id, 'Stopped', false);
        await refreshProjectStatus(id, { reason: 'stop request', retry: true, fallbackStatus: 'stopped' });
        if (opts.reload !== false && opts.reload === true) location.reload();
        return { ok: true, data: data };
      } catch (err) {
        showProjectFeedback(id, 'Stop failed: ' + errorMessage(err), true);
        refreshProjectStatus(id, { reason: 'stop failure', retry: true, fallbackStatus: 'running' });
        return { ok: false, error: err };
      }
    };

    window.restartProject = async function(id) {
      clearProjectFeedback(id);
      showProjectDetailStatus(id, 'Restarting...', false);
      setProjectButtonBusy(id, 'Restarting...');
      try {
        var data = await postProjectLifecycle(id, 'restart');
        if (data.status) {
          reconcileProjectStatusSnapshot({ id: id, status: data.status, health: data.health });
        }
        subscribeProjectStartup(id);
        refreshProjectStatus(id, { reason: 'restart request', retry: true, fallbackStatus: data.status || 'starting' });
        return { ok: true, data: data };
      } catch (err) {
        showBuildLogFromResponse(id, err.responseData);
        showProjectFeedback(id, 'Restart failed: ' + errorMessage(err), true);
        refreshProjectStatus(id, { reason: 'restart failure', retry: true, fallbackStatus: 'running' });
        return { ok: false, error: err };
      }
    };

    // Auto-refresh every 30 seconds (only when no project is expanded)
    setInterval(function() {
      if (!document.querySelector('.project-row.expanded')) {
        location.reload();
      }
    }, 30000);

    // Subscribe to startup progress for all projects currently starting
    <% for (const project of projects) { %>
      <% if (project.health === 'starting') { %>
    (function() {
      setProjectButtonBusy('<%= project.id %>', 'Starting...');
      subscribeProjectStartup('<%= project.id %>');
    })();
      <% } %>
    <% } %>
  </script>
</body>
</html>
