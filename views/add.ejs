<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Project - jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a href="/">🏠 jump.sh</a></h1>
  </header>

  <main>
    <div class="form-container">
      <h2>Add Project</h2>
      
      <form action="/projects" method="POST">
        <div class="form-group">
          <label for="path">Project Folder</label>
          <input type="text" id="path" name="path" required placeholder="/home/user/projects/my-app" list="folder-options">
          <datalist id="folder-options">
            <% (folderOptions || []).forEach(function(folder) { %>
              <option value="<%= folder %>"></option>
            <% }) %>
          </datalist>
          <small>Absolute path to project folder. docker-compose is optional; jump.sh will generate one when possible.</small>
        </div>

        <div class="form-group">
          <label for="name">Project Name</label>
          <input type="text" id="name" name="name" required placeholder="my-app">
          <small>Will be used for subdomain: <span id="subdomain-preview">my-app</span>.<%= config.domain %></small>
        </div>

        <div class="form-actions">
          <a href="/" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">Add Project</button>
        </div>
      </form>

      <script>
        const pathInput = document.getElementById('path');
        const nameInput = document.getElementById('name');
        const subdomainPreview = document.getElementById('subdomain-preview');

        function folderToName(path) {
          return path.replace(/\/+$/, '').split('/').pop() || '';
        }

        pathInput.addEventListener('change', function() {
          const name = folderToName(this.value);
          if (name && !nameInput.dataset.userEdited) {
            nameInput.value = name;
            subdomainPreview.textContent = name;
          }
        });

        nameInput.addEventListener('input', function() {
          nameInput.dataset.userEdited = this.value ? 'true' : '';
          subdomainPreview.textContent = this.value || 'my-app';
        });
      </script>
    </div>
  </main>
</body>
</html>
