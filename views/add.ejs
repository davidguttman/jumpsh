<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Project - jump.sh</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1><a href="/">🏠 jump.sh</a></h1>
  </header>

  <main>
    <div class="form-container">
      <h2>Add Project</h2>

      <form action="/projects" method="POST">
        <input type="hidden" id="path" name="path" required>

        <div id="browser-section">
          <div class="folder-path-bar" id="path-bar">/</div>
          <div class="column-browser" id="column-browser"></div>
          <div class="folder-modal-footer">
            <button type="button" class="btn" id="modal-select">select this folder</button>
          </div>
        </div>

        <div id="fields-section" style="display: none;">
          <div id="detection-loading" class="detection-loading" style="display: none;">detecting...</div>
          <div id="detection-error" class="detection-error" style="display: none;"></div>

          <div class="form-group">
            <label>Project Directory</label>
            <div class="path-display has-path" id="path-display"></div>
          </div>

          <div class="form-group">
            <label for="name">Project Name</label>
            <input type="text" id="name" name="name" required placeholder="my-app">
            <small>Will be used for subdomain: <span id="subdomain-preview">my-app</span>.<%= config.domain %></small>
          </div>

          <div class="form-group">
            <label for="detect-install">Build Command</label>
            <input type="text" id="detect-install" name="override_build_command" placeholder="—">
          </div>

          <div class="form-group">
            <label for="detect-dev">Start Command</label>
            <input type="text" id="detect-dev" name="override_start_command" placeholder="—">
          </div>

          <div class="form-group">
            <label for="detect-port">Port</label>
            <input type="text" id="detect-port" name="override_port" placeholder="—">
          </div>

          <div class="form-group">
            <label for="detect-docker-image">Docker Image</label>
            <input type="text" id="detect-docker-image" name="override_docker_image" placeholder="—">
          </div>

          <div class="form-actions">
            <a href="/" class="btn">Cancel</a>
            <button type="submit" class="btn btn-primary">Add Project</button>
          </div>
        </div>
      </form>

      <script>
        var pathInput = document.getElementById('path');
        var nameInput = document.getElementById('name');
        var subdomainPreview = document.getElementById('subdomain-preview');
        var fieldsSection = document.getElementById('fields-section');
        var pathDisplay = document.getElementById('path-display');
        var lastDetectedPath = '';
        var detectedDefaults = {};

        function folderToName(p) {
          return p.replace(/\/+$/, '').split('/').pop() || '';
        }

        function runDetection(projectPath) {
          if (!projectPath || projectPath === lastDetectedPath) return;
          lastDetectedPath = projectPath;

          var loading = document.getElementById('detection-loading');
          var error = document.getElementById('detection-error');

          loading.style.display = '';
          error.style.display = 'none';

          fetch('/api/detect?path=' + encodeURIComponent(projectPath))
            .then(function (res) {
              if (!res.ok) return res.json().then(function (d) { throw new Error(d.error || 'Detection failed'); });
              return res.json();
            })
            .then(function (data) {
              loading.style.display = 'none';
              if (data.error) {
                error.textContent = data.error;
                error.style.display = '';
                return;
              }
              detectedDefaults = {
                install: data.installCommand || '',
                dev: data.devCommand || '',
                port: data.port ? String(data.port) : '',
                dockerImage: data.dockerImage || ''
              };
              document.getElementById('detect-install').value = detectedDefaults.install;
              document.getElementById('detect-dev').value = detectedDefaults.dev;
              document.getElementById('detect-port').value = detectedDefaults.port;
              document.getElementById('detect-docker-image').value = detectedDefaults.dockerImage;
            })
            .catch(function (err) {
              loading.style.display = 'none';
              error.textContent = err.message;
              error.style.display = '';
            });
        }

        pathInput.addEventListener('change', function() {
          var name = folderToName(this.value);
          if (this.value) {
            pathDisplay.textContent = this.value;
            fieldsSection.style.display = '';
          }
          if (name && !nameInput.dataset.userEdited) {
            nameInput.value = name;
            subdomainPreview.textContent = name.replace(/\./g, '-');
          }
          runDetection(this.value);
        });

        nameInput.addEventListener('input', function() {
          nameInput.dataset.userEdited = this.value ? 'true' : '';
          subdomainPreview.textContent = (this.value || 'my-app').replace(/\./g, '-');
        });

        // On submit, clear override fields that match detected defaults (no override needed)
        document.querySelector('form').addEventListener('submit', function() {
          var installInput = document.getElementById('detect-install');
          var devInput = document.getElementById('detect-dev');
          var portInput = document.getElementById('detect-port');
          var dockerImageInput = document.getElementById('detect-docker-image');
          if (installInput.value === detectedDefaults.install) installInput.value = '';
          if (devInput.value === detectedDefaults.dev) devInput.value = '';
          if (portInput.value === detectedDefaults.port) portInput.value = '';
          if (dockerImageInput.value === detectedDefaults.dockerImage) dockerImageInput.value = '';
        });
      </script>
    </div>
  </main>

  <script>
  (function () {
    var columns = []
    var browser = document.getElementById('column-browser')
    var pathBar = document.getElementById('path-bar')
    var pathInput = document.getElementById('path')
    var browserSection = document.getElementById('browser-section')
    var homeDir = '<%= homeDir %>'

    document.getElementById('modal-select').addEventListener('click', function () {
      pathInput.value = getSelectedPath()
      pathInput.dispatchEvent(new Event('change'))
      browserSection.style.display = 'none'
    })

    // Auto-load home directory on page load
    function initBrowser(startPath) {
      var parts = startPath.split('/').filter(Boolean)
      columns = []
      loadColumn('/', 0).then(function () {
        return parts.reduce(function (chain, part, i) {
          return chain.then(function () {
            var col = columns[i]
            if (!col || !col.directories) return
            var idx = col.directories.indexOf(part)
            if (idx === -1) return
            col.selected = idx
            renderColumns()
            return loadColumn('/' + parts.slice(0, i + 1).join('/'), i + 1)
          })
        }, Promise.resolve())
      }).then(function () {
        var deepPath = getSelectedPath()
        if (deepPath !== '/' && columns.length > 0) {
          var lastCol = columns[columns.length - 1]
          if (lastCol.selected === undefined) return
          loadColumn(deepPath, columns.length)
        }
      })
    }

    initBrowser(homeDir)

    function getSelectedPath() {
      var parts = ['/']
      for (var i = 0; i < columns.length; i++) {
        var col = columns[i]
        if (col.selected === undefined) break
        parts.push(col.directories[col.selected])
      }
      var p = parts[0] + parts.slice(1).join('/')
      return p === '/' ? '/' : p
    }

    function loadColumn(dirPath, index) {
      // Trim columns to this index
      columns = columns.slice(0, index)
      columns.push({ path: dirPath, loading: true, directories: null, error: null, selected: undefined })
      renderColumns()

      return fetch('/api/browse?path=' + encodeURIComponent(dirPath))
        .then(function (res) {
          if (!res.ok) return res.json().then(function (d) { throw new Error(d.error || 'Failed to load') })
          return res.json()
        })
        .then(function (data) {
          columns[index] = { path: data.current, loading: false, directories: data.directories, error: null, selected: undefined }
          renderColumns()
        })
        .catch(function (err) {
          columns[index] = { path: dirPath, loading: false, directories: null, error: err.message, selected: undefined }
          renderColumns()
        })
    }

    function renderColumns() {
      pathBar.textContent = getSelectedPath()
      browser.innerHTML = ''

      for (var i = 0; i < columns.length; i++) {
        var col = columns[i]
        var colEl = document.createElement('div')
        colEl.className = 'column'

        if (col.loading) {
          colEl.innerHTML = '<div class="column-state">loading...</div>'
        } else if (col.error) {
          colEl.innerHTML = '<div class="column-state">' + escapeHtml(col.error) + '</div>'
        } else if (!col.directories || col.directories.length === 0) {
          colEl.innerHTML = '<div class="column-state">(empty)</div>'
        } else {
          for (var j = 0; j < col.directories.length; j++) {
            var item = document.createElement('div')
            item.className = 'column-item' + (col.selected === j ? ' selected' : '')
            item.innerHTML = '<span class="name">' + escapeHtml(col.directories[j]) + '</span><span class="arrow">\u203A</span>'
            item.dataset.colIndex = i
            item.dataset.dirIndex = j
            item.addEventListener('click', onItemClick)
            colEl.appendChild(item)
          }
        }

        browser.appendChild(colEl)
      }

      // Scroll right to show new column
      browser.scrollLeft = browser.scrollWidth
      // Scroll selected items into view vertically within their columns
      var selectedItems = browser.querySelectorAll('.column-item.selected')
      for (var s = 0; s < selectedItems.length; s++) {
        selectedItems[s].scrollIntoView({ block: 'nearest', inline: 'nearest' })
      }
      // Re-pin horizontal scroll to the right
      browser.scrollLeft = browser.scrollWidth
    }

    function onItemClick(e) {
      var target = e.currentTarget
      var colIdx = parseInt(target.dataset.colIndex)
      var dirIdx = parseInt(target.dataset.dirIndex)
      var col = columns[colIdx]

      col.selected = dirIdx

      // Remove columns after this one
      columns = columns.slice(0, colIdx + 1)

      var newPath = getSelectedPath()
      loadColumn(newPath, colIdx + 1)
    }

    function escapeHtml(str) {
      var div = document.createElement('div')
      div.textContent = str
      return div.innerHTML
    }
  })()
  </script>
</body>
</html>
