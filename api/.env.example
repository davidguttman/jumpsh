# Server
PORT=3000

# GCP Cloud DNS
# Option 1: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option 2: base64-encoded service account JSON (for Render/containers)
# GCP_CREDENTIALS_BASE64=base64-encoded-json
GCP_DNS_ZONE=jump-sh
JUMP_DOMAIN=jump.sh

# GitHub OAuth (for registration fallback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
