# Server
PORT=3000

# GCP Cloud DNS
# Option 1: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option 2: base64-encoded service account JSON (for Render/containers)
# GCP_CREDENTIALS_BASE64=base64-encoded-json
GCP_DNS_ZONE=jump-sh
JUMP_DOMAIN=jump.sh

# Cloud Scheduler certificate renewal endpoint secret
# Send as: Authorization: Bearer $JUMPSH_RENEW_CERTS_SECRET
JUMPSH_RENEW_CERTS_SECRET=change-me

# GitHub OAuth (for Device Flow registration fallback)
# This is a public client ID — not secret
GITHUB_CLIENT_ID=
