{
  "name": "jump.sh",
  "version": "0.10.0",
  "type": "module",
  "description": "jump.sh — local dev server with Docker containers + subdomain routing",
  "main": "server.js",
  "bin": {
    "jump.sh": "./bin/jumpsh.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:all": "node --test test/*.test.js test/e2e/*.test.js",
    "test:lifecycle": "scripts/e2e-lifecycle.sh",
    "api:install": "cd api && npm install",
    "api:start": "node api/server.js",
    "prepare": "scripts/install-hooks.sh",
    "test:flakiness": "node scripts/analyze-test-flakiness.js",
    "test:lint-flaky": "node scripts/scan-flaky-patterns.js"
  },
  "keywords": [
    "dev",
    "local",
    "docker",
    "dashboard",
    "proxy",
    "subdomain"
  ],
  "author": "David Guttman",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin/",
    "lib/",
    "services/",
    "views/",
    "public/",
    "server.js",
    "database.js",
    "scripts/enable-low-port-bind-linux.sh"
  ],
  "dependencies": {
    "dotenv": "^17.0.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "get-port": "^7.1.0",
    "http-proxy-middleware": "^3.0.0",
    "lowdb": "^7.0.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "nodemon": "^3.1.0",
    "ws": "^8.19.0"
  }
}
